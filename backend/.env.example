# ==========================================
# Backend Environment Configuration
# ==========================================

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Storage Driver: 'memory' | 'sqlite' | 'supabase' (defaults to 'memory' if unspecified)
STORAGE_DRIVER=memory

# SQLite Configuration (used when STORAGE_DRIVER=sqlite or as local fallback)
# Use ':memory:' for in-memory DB or a relative/absolute path like './data/burger.db'
DATABASE_PATH=:memory:

# Supabase Configuration (required when STORAGE_DRIVER=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_ANON_KEY=your_anon_key

# PostgreSQL TLS (STORAGE_DRIVER=postgres|supabase against a remote DATABASE_URL).
# Without one of these the connection is encrypted but the server certificate is
# NOT verified. Paste the Supabase root CA (Dashboard > Database settings > SSL
# Configuration > Download certificate) as PEM; "\n" escapes are accepted.
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DATABASE_SSL_VERIFY=true   # verify against the system CAs instead

# API reference (/docs). Off in production unless explicitly enabled.
# API_DOCS_ENABLED=true

# Per-client rate limiting behind a reverse proxy: number of trusted proxy hops.
# TRUST_PROXY=1
