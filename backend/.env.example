# ==========================================
# Backend Environment Configuration
# ==========================================

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Storage Driver: 'memory' | 'sqlite' | 'supabase' (defaults to 'memory' if unspecified)
STORAGE_DRIVER=memory

# SQLite Configuration (used when STORAGE_DRIVER=sqlite or as local fallback)
# Use ':memory:' for in-memory DB or a relative/absolute path like './data/burger.db'
DATABASE_PATH=:memory:

# Supabase Configuration (required when STORAGE_DRIVER=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_ANON_KEY=your_anon_key
