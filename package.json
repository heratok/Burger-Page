{
  "name": "burger-page-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter burger-page-frontend run dev",
    "dev:frontend": "pnpm --filter burger-page-frontend run dev",
    "dev:backend": "pnpm --filter burger-page-backend run dev",
    "build": "pnpm --filter @burger-page/contracts run build && pnpm --filter burger-page-frontend run build && pnpm --filter burger-page-backend run build",
    "build:contracts": "pnpm --filter @burger-page/contracts run build",
    "build:frontend": "pnpm --filter burger-page-frontend run build",
    "build:backend": "pnpm --filter burger-page-backend run build",
    "create:admin": "pnpm --filter burger-page-backend run create:admin",
    "db:migrate": "doppler run -- node ./node_modules/node-pg-migrate/bin/node-pg-migrate.js -m database/migrations --ignore-pattern \".*\\.down\\.sql|.*\\.md\" up",
    "db:baseline": "doppler run -- node ./node_modules/node-pg-migrate/bin/node-pg-migrate.js -m database/migrations --ignore-pattern \".*\\.down\\.sql|.*\\.md\" up --fake",
    "db:migrate:down": "doppler run -- bash database/scripts/migrate-down.sh",
    "db:migrate:create": "doppler run -- node ./node_modules/node-pg-migrate/bin/node-pg-migrate.js -m database/migrations --migration-file-language sql create",
    "db:test:setup": "bash database/scripts/local-pg.sh setup",
    "db:test:start": "bash database/scripts/local-pg.sh start",
    "db:test:stop": "bash database/scripts/local-pg.sh stop",
    "db:test:status": "bash database/scripts/local-pg.sh status",
    "test": "pnpm --filter @burger-page/contracts run test && pnpm --filter burger-page-frontend run test && pnpm --filter burger-page-backend run test",
    "test:contracts": "pnpm --filter @burger-page/contracts run test",
    "test:frontend": "pnpm --filter burger-page-frontend run test",
    "test:backend": "pnpm --filter burger-page-backend run test",
    "test:integration:postgres": "pnpm --filter burger-page-backend run test:integration:postgres",
    "typecheck": "pnpm --filter @burger-page/contracts run build && pnpm --filter burger-page-backend run typecheck && pnpm --filter burger-page-frontend run typecheck",
    "typecheck:frontend": "pnpm --filter burger-page-frontend run typecheck",
    "typecheck:backend": "pnpm --filter burger-page-backend run typecheck",
    "lint": "pnpm --filter burger-page-frontend run lint",
    "prepare": "node -e \"try{require('node:child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\"",
    "preview": "pnpm --filter burger-page-frontend run preview"
  },
  "devDependencies": {
    "node-pg-migrate": "^9.0.0"
  }
}
