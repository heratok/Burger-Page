{
  "name": "burger-page-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix packages/contracts run build && npm --prefix frontend run build && npm --prefix backend run build",
    "build:contracts": "npm --prefix packages/contracts run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "create:admin": "npm --prefix backend run create:admin",
    "db:migrate": "doppler run -- node ./node_modules/node-pg-migrate/bin/node-pg-migrate.js -m database/migrations --ignore-pattern \".*\\.down\\.sql|.*\\.md\" up",
    "db:baseline": "doppler run -- node ./node_modules/node-pg-migrate/bin/node-pg-migrate.js -m database/migrations --ignore-pattern \".*\\.down\\.sql|.*\\.md\" baseline",
    "db:migrate:down": "doppler run -- node ./node_modules/node-pg-migrate/bin/node-pg-migrate.js -m database/migrations --ignore-pattern \".*\\.up\\.sql|.*\\.md\" down",
    "db:migrate:create": "doppler run -- node ./node_modules/node-pg-migrate/bin/node-pg-migrate.js -m database/migrations --migration-file-language sql create",
    "test": "npm --prefix packages/contracts run test && npm --prefix frontend run test && npm --prefix backend run test",
    "test:contracts": "npm --prefix packages/contracts run test",
    "test:frontend": "npm --prefix frontend run test",
    "test:backend": "npm --prefix backend run test",
    "test:integration:postgres": "npx tsx backend/scripts/run-postgres-tests.ts",
    "typecheck": "npm --prefix packages/contracts run build && npm --prefix backend run typecheck && npm --prefix frontend run typecheck",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "lint": "npm --prefix frontend run lint",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "preview": "npm --prefix frontend run preview"
  },
  "devDependencies": {
    "node-pg-migrate": "^9.0.0"
  }
}
