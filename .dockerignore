# Nested workspace installs must be excluded too: a bare `node_modules` only
# matches the context root, so `COPY backend ./backend` would ship host pnpm
# links (absolute Windows paths) over the Linux links inside the image.
**/node_modules
**/dist
.git
.github
.playwright-cli
playwright-report
test-results
*.log
# Secret files must be excluded at every level, not only at the context root:
# a nested `backend/.env` would otherwise be copied by `COPY backend ./backend`
# into the builder stage and its layer. A leading `**/` also matches the root,
# so these forms replace the old root-only lines; the example-file negation is
# restated at every level, otherwise nothing would be allowed back in.
**/.env
**/.env.*
!**/.env.example
.DS_Store
Thumbs.db
